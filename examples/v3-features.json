{
  "version": 3,
  "systemLayout": "compact-left-v2",
  "title": "Tabelas, eventos e componente reativo",
  "kicker": "ANIMATED FLOW STUDIO 3",
  "description": "Arraste as portas azuis para conectar. Ctrl + roda aplica zoom; arraste o fundo para navegar.",
  "width": 1100,
  "height": 600,
  "autoGrow": true,
  "growthMargin": 48,
  "showLegend": true,
  "grid": true,
  "trafficSpeed": 1,
  "legends": [
    {
      "id": "request",
      "label": "Solicitação",
      "color": "#70a0ff",
      "shape": "square",
      "direction": "forward",
      "effect": "comet",
      "speed": 1,
      "size": 10,
      "count": 1
    },
    {
      "id": "response",
      "label": "Resposta",
      "color": "#9ae8c5",
      "shape": "circle",
      "direction": "reverse",
      "effect": "pulse",
      "speed": 0.8,
      "size": 8,
      "count": 1
    },
    {
      "id": "cdc",
      "label": "Alterações (CDC)",
      "color": "#bb8ae8",
      "shape": "star",
      "direction": "forward",
      "effect": "glow",
      "speed": 1,
      "size": 8,
      "count": 1
    }
  ],
  "nodes": [
    {
      "id": "client",
      "type": "system",
      "label": "Cliente",
      "subtitle": "",
      "x": 40,
      "y": 160,
